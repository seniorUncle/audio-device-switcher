<Window x:Class="AudioSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频设备切换器"
        SizeToContent="WidthAndHeight"
        MaxWidth="860"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 分区折叠标题：箭头 + 标题文字，点击展开/收起对应设备列表 -->
        <Style x:Key="SectionHeaderStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="12,12,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ArrowRight" Text="&#x25B8;" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="ArrowDown" Text="&#x25BE;" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="16" Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Visibility" Value="Visible" TargetName="ArrowDown"/>
                                <Setter Property="Visibility" Value="Collapsed" TargetName="ArrowRight"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DeviceItemTemplate">
            <Button Style="{StaticResource DeviceItemButton}"
                    Tag="{Binding Id}" Margin="0,6,0,0"
                    Click="DeviceItem_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="13" TextWrapping="Wrap" MaxWidth="208"
                                   HorizontalAlignment="Left" TextAlignment="Left"/>
                        <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11" Margin="0,2,0,0"
                                   HorizontalAlignment="Left" TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2713; 当前" Foreground="{DynamicResource SelectedTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                      Tag="{Binding Id}" Margin="8,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                      Click="DeviceToggle_Click"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Border CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Height="34" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="音频设备切换器" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                    <TextBlock Text=" · 快捷切换输出/输入设备" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="8,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OpenWindowsSoundSettings_Click" Cursor="Hand" Height="34"
                            Background="Transparent" BorderThickness="0" Padding="14,0" Focusable="False">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="WindowsIcon" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows声音设置" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Height="34" Content="&#x2500;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CloseButton}" Height="34" Content="&#x2715;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 内容区：左右两栏（左输出 / 右输入），设备较多时可滚动查看。
                 滚动条为悬浮式，覆盖在内容右侧，不占布局空间、不撑大窗口 -->
            <ScrollViewer Grid.Row="1" MaxHeight="640"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- 悬浮滚动条模板：内容与滚动条叠加在同一个网格，滚动条悬浮于内容之上 -->
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <!-- 命名 Presenter 确保 ScrollViewer 建立 extent/viewport 连接 -->
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Margin="{TemplateBinding Padding}"/>
                            <!-- 右侧悬浮垂直细滚动条：内联定义，2px 半透明白滑块，圆角胶囊 -->
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical" Background="Transparent"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                       Width="5" Margin="0">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <!-- 悬浮条：轨道上下各留 4px 边距，滑块不硬贴轨道顶/底边；滑块固定 1.5px 宽并居中 -->
                                        <Grid Background="Transparent" Margin="0,4,0,15">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                                <Track.Thumb>
                                                    <Thumb MinHeight="20">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBorder" CornerRadius="0.75"
                                                                        HorizontalAlignment="Center" Width="1.5"
                                                                        Background="{DynamicResource TextSecondary}"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Background"
                                                                                Value="{StaticResource TextPrimary}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal" Background="Transparent"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <StackPanel Margin="14,4,14,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：输出设备 -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Height="76">
                            <Grid>
                                <TextBlock Text="当前输出" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CurrentDeviceText" Foreground="{DynamicResource SelectedTextBrush}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="260"
                                           TextAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,12"/>
                            </Grid>
                        </Border>

                        <!-- 已启用设备（可折叠） -->
                        <ToggleButton x:Name="OutputEnabledHeader" Style="{StaticResource SectionHeaderStyle}"
                                      Content="已启用" IsChecked="True"
                                      Checked="SectionHeader_Changed" Unchecked="SectionHeader_Changed"/>
                        <ItemsControl x:Name="DeviceList"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"/>

                        <!-- 未启用设备（可折叠） -->
                        <ToggleButton x:Name="DisabledOutputHeader" Style="{StaticResource SectionHeaderStyle}"
                                      Content="未启用" IsChecked="True" Visibility="Collapsed"
                                      Checked="SectionHeader_Changed" Unchecked="SectionHeader_Changed"/>
                        <ItemsControl x:Name="DisabledDeviceList"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"/>
                    </StackPanel>

                    <!-- 右栏：输入设备 -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Height="76">
                            <Grid>
                                <TextBlock Text="当前输入" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CurrentInputText" Foreground="{DynamicResource SelectedTextBrush}"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="260"
                                           TextAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,12"/>
                            </Grid>
                        </Border>

                        <!-- 已启用设备（可折叠） -->
                        <ToggleButton x:Name="InputEnabledHeader" Style="{StaticResource SectionHeaderStyle}"
                                      Content="已启用" IsChecked="True"
                                      Checked="SectionHeader_Changed" Unchecked="SectionHeader_Changed"/>
                        <ItemsControl x:Name="InputDeviceList"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"/>

                        <!-- 未启用设备（可折叠） -->
                        <ToggleButton x:Name="DisabledInputHeader" Style="{StaticResource SectionHeaderStyle}"
                                      Content="未启用" IsChecked="True" Visibility="Collapsed"
                                      Checked="SectionHeader_Changed" Unchecked="SectionHeader_Changed"/>
                        <ItemsControl x:Name="DisabledInputDeviceList"
                                      ItemTemplate="{StaticResource DeviceItemTemplate}"/>
                    </StackPanel>
                </Grid>

                <!-- 开机自启 -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="开机自启" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="随 Windows 启动，常驻托盘" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource SwitchToggle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"/>
                    </Grid>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
